# Copy to `.env` and fill in. NEVER commit `.env`.
# Only the dev smoke runner reads these — the production extension uses
# chrome.storage BYOK (see docs/API_KEY_SECURITY.md).

# ---- LLM ----
# Pick ONE of the providers below. The smoke runner reads LLM_PROVIDER to choose.
LLM_PROVIDER=gemini

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite

# Anthropic Claude — https://console.anthropic.com/settings/keys (optional, stub only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ---- Search ----
# Brave Search — https://api.search.brave.com/app/keys (optional; smoke runner can use MockSearch)
BRAVE_API_KEY=
