# Copy to `.env` and fill in. NEVER commit `.env`.
#
# Text-generation API keys are now SERVER-SIDE (Vercel env var THEGRID_API_KEY).
# The extension and this smoke runner never hold an LLM key — they hit the
# deployed proxy at https://troll-breaker-browser.vercel.app/api/chat.
#
# Only the dev smoke runner reads the values below.

# ---- LLM proxy ----
# Optional override. Defaults to the production Vercel URL.
# Set to http://localhost:3000/api/chat if running `vercel dev` locally.
PROXY_URL=

# ---- Search ----
# Brave Search — https://api.search.brave.com/app/keys (optional; smoke runner can use MockSearch)
BRAVE_API_KEY=
